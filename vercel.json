{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/index.js": {
      "includeFiles": "migrations/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__api_path=:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}